# Copy to hackathon-demo/.env or export these in your shell.
# .env is gitignored. Leave the key empty in this example file.

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional.
# NEBIUS_MAX_TOKENS=1800
# NEBIUS_TEMPERATURE=0.2
# NEBIUS_TIMEOUT_SECONDS=180
